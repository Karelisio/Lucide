<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Lien profond interne (pas un lien web) utilisé par le widget d'écran d'accueil pour
              ouvrir directement le formulaire de saisie : io.karelisio.lucide://dreams/new.
              Intercepté côté JS via le plugin App de Capacitor (appUrlOpen).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.karelisio.lucide" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".DreamWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dream_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!--
      Requise par le moteur WebView d'Android pour servir le contenu local de
      l'application (même hors ligne, WebView a besoin de cette permission pour
      ouvrir son serveur local https://localhost). Les données du journal de
      rêves ne quittent jamais l'appareil : la seule requête réseau de l'app est
      la vérification manuelle des mises à jour (Réglages > Mises à jour), qui
      contacte uniquement l'API publique de GitHub.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nécessaire pour l'enregistrement des mémos vocaux (capacitor-voice-recorder). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Nécessaire pour proposer l'installation d'un APK téléchargé depuis les
      releases GitHub (mise à jour manuelle, l'app n'étant pas distribuée via
      le Play Store). Android affichera un écran de confirmation système avant
      toute installation.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
